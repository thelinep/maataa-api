# Internal SSO authority. Use the exact Keycloak realm issuer URL.
AUTH_ISSUER_URL=https://sso.example.invalid/realms/maataa
AUTH_JWKS_URL=https://sso.example.invalid/realms/maataa/protocol/openid-connect/certs
AUTH_API_AUDIENCE=maataa-api
# Keycloak client IDs allowed to obtain API-audience tokens.
AUTH_ALLOWED_CLIENT_IDS=maataa-web,tlps-web
# API rejects tokens older than this even if the issuer accidentally creates longer ones.
AUTH_MAX_TOKEN_AGE_SECONDS=300
PORT=8787
HOST=127.0.0.1
